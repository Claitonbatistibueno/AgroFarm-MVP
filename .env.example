# Copy this file to .env and fill in real values. NEVER commit .env.
APP_ENV=local            # local = show errors | production = hide errors
APP_TIMEZONE=Europe/Dublin

DB_HOST=localhost
DB_PORT=3306
DB_NAME=farmproject
DB_USER=root
DB_PASS=

# Claude API (AI Clinical Assistant). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PUBMED_ENABLED=1         # 1 = add PubMed article titles as evidence
